{
  "name": "cinecrew-player-electron-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "vite build",
    "start": "electron .",
    "stage:vlc:mac": "node scripts/stage-vlc.mjs mac",
    "stage:vlc:win": "node scripts/stage-vlc.mjs win",
    "dist:mac": "npm run stage:vlc:mac && npm run build && electron-builder --mac dmg",
    "dist:win": "npm run stage:vlc:win && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@mediabunny/ac3": "^1.59.0",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-community/slider": "4.5.5",
    "dashjs": "^5.2.1",
    "electron-vlc-player": "^1.0.2",
    "expo": "~52.0.49",
    "expo-video": "~2.0.6",
    "flv.js": "^1.6.2",
    "hls.js": "^1.7.3",
    "mediabunny": "^1.59.0",
    "prop-types": "^15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "com.cinecrew.player.demo",
    "productName": "CineCrew Player Demo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "resources/vlc",
        "to": "vlc"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    },
    "dmg": {
      "artifactName": "cinecrew-player-demo.dmg"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "cinecrew-player-demo-setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
